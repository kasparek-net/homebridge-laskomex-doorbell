{
  "pluginAlias": "LaskomexDoorbell",
  "pluginType": "platform",
  "singular": true,
  "headerDisplay": "Brings a Laskomex intercom with the Smart Unifon ESPHome module into HomeKit over MQTT: doorbell, door release, do-not-disturb and auto-open.",
  "footerDisplay": "Topics are prefilled according to the Smart Unifon manual (SW 2.7.2). Only change them if the module's ESPHome name is not \"smart-unifon\".",
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "default": "Intercom",
        "required": true,
        "description": "Base for accessory names in the Home app (e.g. \"Intercom Doorbell\")."
      },
      "doorbellType": {
        "title": "Doorbell type in HomeKit",
        "type": "string",
        "default": "doorbell",
        "oneOf": [
          {
            "title": "Doorbell — announced on HomePods",
            "enum": [
              "doorbell"
            ]
          },
          {
            "title": "Motion sensor — silent on HomePods",
            "enum": [
              "motion"
            ]
          }
        ],
        "description": "HomePods announce doorbells globally and it cannot be turned off for one accessory. A motion sensor only sends a notification."
      },
      "motionSeconds": {
        "title": "Motion duration on ring (s)",
        "type": "integer",
        "default": 5,
        "minimum": 1,
        "maximum": 60,
        "condition": {
          "functionBody": "return model.doorbellType === 'motion';"
        }
      },
      "callNumber": {
        "title": "Flat number",
        "type": "integer",
        "required": false,
        "description": "Only report rings for calls to this flat. Empty = every ring."
      },
      "names": {
        "title": "Accessory names",
        "type": "object",
        "description": "Optional. Defaults to \"<Name> Doorbell\", \"<Name> Lock\", \"<Name> Do Not Disturb\" and \"<Name> Auto Open\".",
        "properties": {
          "doorbell": {
            "title": "Doorbell",
            "type": "string",
            "required": false
          },
          "lock": {
            "title": "Lock",
            "type": "string",
            "required": false
          },
          "dnd": {
            "title": "Do not disturb",
            "type": "string",
            "required": false
          },
          "autoOpen": {
            "title": "Auto open",
            "type": "string",
            "required": false
          }
        }
      },
      "broker": {
        "title": "MQTT broker",
        "type": "object",
        "properties": {
          "host": {
            "title": "Host",
            "type": "string",
            "required": true,
            "placeholder": "192.168.1.10"
          },
          "port": {
            "title": "Port",
            "type": "integer",
            "default": 1883,
            "required": true
          },
          "username": {
            "title": "Username",
            "type": "string",
            "required": false
          },
          "password": {
            "title": "Password",
            "type": "string",
            "required": false,
            "x-schema-form": {
              "type": "password"
            }
          }
        }
      },
      "topics": {
        "title": "MQTT topics",
        "type": "object",
        "properties": {
          "ring": {
            "title": "Ring (subscribe)",
            "type": "string",
            "required": true,
            "placeholder": "smart-unifon/binary_sensor/doorbell__ring_/state"
          },
          "openDoor": {
            "title": "Open door (publish)",
            "type": "string",
            "required": false,
            "placeholder": "smart-unifon/button/open_door/command",
            "description": "Leave empty if you don't want the lock in HomeKit."
          },
          "openDoorPayload": {
            "title": "Open door payload",
            "type": "string",
            "default": "PRESS",
            "description": "Door release is an ESPHome \"button\", so the payload is PRESS (not ON)."
          },
          "dndCommand": {
            "title": "Do not disturb — command (publish)",
            "type": "string",
            "required": false,
            "description": "Leave empty if you don't want the do-not-disturb switch.",
            "placeholder": "smart-unifon/switch/mute/command"
          },
          "dndState": {
            "title": "Do not disturb — state (subscribe)",
            "type": "string",
            "required": false,
            "placeholder": "smart-unifon/switch/mute/state"
          },
          "dndOnPayload": {
            "title": "On payload",
            "type": "string",
            "default": "ON"
          },
          "dndOffPayload": {
            "title": "Off payload",
            "type": "string",
            "default": "OFF"
          },
          "availability": {
            "title": "Module availability (subscribe)",
            "type": "string",
            "required": false,
            "placeholder": "smart-unifon/status"
          },
          "availablePayload": {
            "title": "Online payload",
            "type": "string",
            "default": "online"
          },
          "decoder": {
            "title": "Called flat number (subscribe)",
            "type": "string",
            "required": false,
            "placeholder": "smart-unifon/sensor/decoder/state",
            "description": "Used with \"Flat number\" to ignore calls to neighbours."
          },
          "decodingSuccessful": {
            "title": "Decoding successful (subscribe)",
            "type": "string",
            "required": false,
            "placeholder": "smart-unifon/binary_sensor/decoding_successful/state"
          },
          "autoOpenCommand": {
            "title": "Auto open — command (publish)",
            "type": "string",
            "required": false,
            "placeholder": "smart-unifon/switch/auto_open_door/command",
            "description": "Leave empty if you don't want the auto-open switch."
          },
          "autoOpenState": {
            "title": "Auto open — state (subscribe)",
            "type": "string",
            "required": false,
            "placeholder": "smart-unifon/switch/auto_open_door/state"
          }
        }
      },
      "ringPayload": {
        "title": "Ring payload",
        "type": "string",
        "default": "ON",
        "description": "Value in the ring topic that means \"ringing\"."
      },
      "codeRingMinSeconds": {
        "title": "Code opening — signal from (s)",
        "type": "number",
        "default": 8,
        "description": "The module reports a keypad code opening like a ring; only the RING signal length differs. Signals in this range are treated as a code and ignored."
      },
      "codeRingMaxSeconds": {
        "title": "Code opening — signal to (s)",
        "type": "number",
        "default": 10
      },
      "relockSeconds": {
        "title": "Relock after (s)",
        "type": "integer",
        "default": 5,
        "minimum": 1,
        "maximum": 60,
        "description": "The intercom opens with a pulse and reports no state, so the lock returns to locked in HomeKit after this time."
      },
      "ringWindowSeconds": {
        "title": "Window after ring (s)",
        "type": "integer",
        "default": 60,
        "minimum": 5,
        "maximum": 600,
        "description": "A digital intercom only opens shortly after a call from the outdoor panel. Outside this window the plugin logs a warning."
      },
      "warnIfNoRing": {
        "title": "Warn when opening without a ring",
        "type": "boolean",
        "default": true
      },
      "model": {
        "title": "Model (shown in the Home app)",
        "type": "string",
        "default": "LM-8 smart module"
      }
    }
  }
}
